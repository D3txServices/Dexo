local function IsAsset(icon)
	return type(icon) == "number" or (type(icon) == "string" and (icon:find("rbxassetid") or icon:find("rbxasset://") or icon:match("^%d+$")))
end

local function AssetId(icon)
	if type(icon) == "number" or (type(icon) == "string" and icon:match("^%d+$")) then
		return "rbxassetid://" .. icon
	end
	return icon
end

local function SectionHeader(parent, name, icon, order)
	-- title sits above the card, like "Control", "Sensitivity", "Weapons"
	local Header = New("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = order or 0, Parent = parent })
	local x = 22
	if IsAsset(icon) then
		New("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(13, 13),
			BackgroundTransparency = 1, Image = AssetId(icon), ImageColor3 = "SubFontColor", Parent = Header,
		})
	else
		local ring = New("Frame", {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(11, 11),
			BackgroundTransparency = 1, Parent = Header,
		})
		Round(ring)
		local rs = Stroke(ring, "SubFontColor", 1.5, 0.15)
		rs.Name = "RingStroke"
		ring.Name = "Ring"
	end
	local Title = Text({ Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x - 26, 1, 0), Text = name or "", TextSize = 13, TextColor3 = "SubFontColor", TextTruncate = Enum.TextTruncate.AtEnd, Parent = Header })
	return Header, Title
end

local function Card(column)
	-- wrapper = header + card, kept together in the column
	local Wrap = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1,
		LayoutOrder = NextOrder(), Parent = column,
	})
	List(Wrap, 8)
	local Box = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundColor3 = "MainColor",
		BackgroundTransparency = 0.05, LayoutOrder = 2, Parent = Wrap,
	})
	Corner(Box, 12)
	local bs = Stroke(Box, "OutlineColor", 1, 0.45)
	Box.MouseEnter:Connect(function()
		bs.Color = Scheme.AccentColor
		Tween(bs, { Transparency = 0.3, Thickness = 1.4 }, 0.2)
		Tween(Box, { BackgroundColor3 = Scheme.MainColor:Lerp(Scheme.AccentColor, 0.04) }, 0.2)
	end)
	Box.MouseLeave:Connect(function()
		bs.Color = Scheme.OutlineColor
		Tween(bs, { Transparency = 0.45, Thickness = 1 }, 0.2)
		Tween(Box, { BackgroundColor3 = Scheme.MainColor }, 0.2)
	end)
	List(Box, 0)
	return Box, Wrap
end

local function Container(parent, order)
	local C = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1,
		LayoutOrder = order, Parent = parent,
	})
	List(C, 4)
	Pad(C, 14, 14, 10, 12)
	return C
end

local function CreateGroupbox(column, opts)
	local Box, Wrap = Card(column)
	local Header, Title = SectionHeader(Wrap, opts.Name or "Groupbox", opts.IconName or opts.Icon, 1)
	local C = Container(Box, 2)

	if opts.Description then
		local d = Text({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, Text = opts.Description, TextSize = 12, TextColor3 = "SubFontColor", Parent = C })
		d.LayoutOrder = -1
	end

	local Groupbox = setmetatable({ Container = C, Box = Box, Wrap = Wrap, Name = opts.Name }, BaseGroupbox)

	if not opts.DisableCollapsing then
		local Col = Btn({
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -2, 0.5, 0), Size = UDim2.fromOffset(18, 18),
			Text = "", Parent = Header,
		})
		Chevron(Col, 9)
		function Groupbox:SetCollapsed(c)
			Box.Visible = not c
			Tween(Col, { Rotation = c and -90 or 0 }, 0.2)
		end
		Col.MouseButton1Click:Connect(function() Groupbox:SetCollapsed(Box.Visible) end)
		if opts.Collapsed then Groupbox:SetCollapsed(true) end
	end

	return Groupbox
end

local function CreateTabbox(column, name)
	local Box, Wrap = Card(column)
	-- header row: section title on the left, pill tabs on the right
	local Header = New("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = 1, Parent = Wrap })
	local Pills = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = Header })
	List(Pills, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

	local Tabbox = { Tabs = {}, _list = {}, Wrap = Wrap, Name = name }

	function Tabbox:AddTab(tname)
		local B = Btn({
			Size = UDim2.fromOffset(0, 22), AutomaticSize = AUTO_X, Text = tname, TextSize = 12, FontFace = FONT_MED,
			BackgroundTransparency = 1, BackgroundColor3 = "ComponentColor", TextColor3 = "SubFontColor",
			LayoutOrder = #Tabbox._list + 1, Parent = Pills,
		})
		Round(B)
		Pad(B, 10, 10, 0, 0)
		local C = Container(Box, 2)
		C.Visible = false
		local Sub = setmetatable({ Container = C, Name = tname }, BaseGroupbox)
		local entry = { B = B, C = C }

		function Sub:Show()
			for _, e in ipairs(Tabbox._list) do
				e.C.Visible = false
				Tween(e.B, { TextColor3 = Scheme.SubFontColor, BackgroundTransparency = 1 })
			end
			C.Visible = true
			Tween(B, { TextColor3 = Scheme.FontColor, BackgroundTransparency = 0.1 })
		end
		B.MouseButton1Click:Connect(function() Sub:Show() end)

		table.insert(Tabbox._list, entry)
		Tabbox.Tabs[tname] = Sub
		if #Tabbox._list == 1 then
			Sub:Show()
			Tabbox.Name = Tabbox.Name or tname
		end
		return Sub
	end

	return Tabbox
end

