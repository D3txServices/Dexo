local FlashAlpha = Instance.new("NumberValue")
task.spawn(function()
	while not Library.Unloaded do
		task.wait(1.8)
		if Library.Unloaded then break end
		TweenService:Create(FlashAlpha, TweenInfo.new(0.35, Enum.EasingStyle.Sine), { Value = 1 }):Play()
		task.wait(0.6)
		TweenService:Create(FlashAlpha, TweenInfo.new(0.45, Enum.EasingStyle.Sine), { Value = 0 }):Play()
	end
end)

local hue, rainbowAcc = 0, 0
Connect(RunService.RenderStepped, function(dt)
	if Library.Rainbow then
		hue = (hue + dt * Library.RainbowSpeed) % 1
		rainbowAcc += dt
		Scheme.AccentColor = Color3.fromHSV(hue, 0.75, 1)
		if rainbowAcc >= 0.05 then
			rainbowAcc = 0
			Library:UpdateColors()
		end
	end

	local flash = Scheme.AccentColor:Lerp(WHITE, FlashAlpha.Value)
	for _, f in ipairs(Library.Flashing) do
		f[1][f[2]] = flash
	end

	if Tooltip.Visible then
		local m = MousePos()
		Tooltip.Position = UDim2.fromOffset(m.X + 14, m.Y + 12)
	end
end)

Connect(UIS.InputBegan, function(input)
	if UIS:GetFocusedTextBox() then return end
	local key = Library.ToggleKeybind
	if typeof(key) == "EnumItem" then
		if input.KeyCode == key then Library:Toggle() end
	elseif type(key) == "table" and key.Value and key.Value ~= "None" then
		if InputName(input) == key.Value then Library:Toggle() end
	end
end)

