function Library:Toggle(state)
	local Main, Scale = self._main, self._scale
	if not Main then return end
	if state == nil then state = not self.Toggled end
	self.Toggled = state
	Tooltip.Visible = false
	if not state then for _, f in ipairs(self._popClosers or {}) do pcall(f) end end
	if state then
		Main.Visible = true
		Scale.Scale = self.DPIScale * 0.92
		Tween(Scale, { Scale = self.DPIScale }, 0.3, Enum.EasingStyle.Back)
	else
		Tween(Scale, { Scale = self.DPIScale * 0.92 }, 0.12)
		task.delay(0.12, function()
			if not Library.Toggled then Main.Visible = false end
		end)
	end
end

function Library:SetDPIScale(pct)
	self.DPIScale = (tonumber(pct) or 100) / 100
	if self._scale and self.Toggled then Tween(self._scale, { Scale = self.DPIScale }, 0.2) end
end

function Library:SetNotifySide(side)
	self.NotifySide = side
	if side == "Left" then
		NotifyHolder.AnchorPoint = Vector2.new(0, 1)
		NotifyHolder.Position = UDim2.new(0, 14, 1, -14)
		NotifyHolder.UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	else
		NotifyHolder.AnchorPoint = Vector2.new(1, 1)
		NotifyHolder.Position = UDim2.new(1, -14, 1, -14)
		NotifyHolder.UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	end
end

function Library:Notify(a, b)
	local info = type(a) == "table" and a or { Title = "Dexo Hub", Description = tostring(a), Time = b }
	local time = tonumber(info.Time) or 5
	local offX = self.NotifySide == "Left" and -1.3 or 1.3

	local Wrap = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1, LayoutOrder = NextOrder(), Parent = NotifyHolder })
	local Card = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, Position = UDim2.new(offX, 0, 0, 0),
		BackgroundColor3 = "BackgroundColor", BackgroundTransparency = 0.08, Parent = Wrap,
	})
	Corner(Card, 12)
	AnimatedStroke(Card, 1.2, 0, 90)

	local Bar = New("Frame", { Position = UDim2.fromOffset(6, 8), Size = UDim2.new(0, 3, 0, 26), BackgroundColor3 = "AccentColor", BorderSizePixel = 0, Parent = Card })
	Round(Bar)

	local Body = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1, Parent = Card })
	Pad(Body, 18, 12, 8, 8)
	List(Body, 3)

	local Head = New("Frame", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, LayoutOrder = 1, Parent = Body })
	do local d = New("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 2, 0.5, -4), BackgroundColor3 = "AccentColor", Parent = Head }) Round(d) end
	Text({ Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -20, 1, 0), Text = info.Title or "Dexo Hub", FontFace = FONT_BOLD, TextSize = 13, RichText = true, Parent = Head })
	if info.Description and info.Description ~= "" then
		Text({
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, RichText = true,
			Text = info.Description, TextColor3 = "SubFontColor", TextSize = 12, LayoutOrder = 2, Parent = Body,
		})
	end
	local Track = New("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = "ComponentColor", BorderSizePixel = 0, LayoutOrder = 3, Parent = Body })
	Round(Track)
	local Prog = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = "AccentColor", BorderSizePixel = 0, Parent = Track })
	Round(Prog)

	if info.SoundId then
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. tostring(info.SoundId):gsub("%D", "")
		s.Volume = 1
		s.Parent = ScreenGui
		s:Play()
		game:GetService("Debris"):AddItem(s, 5)
	end

	local Notif = {}
	local dead = false
	function Notif:Destroy()
		if dead then return end
		dead = true
		Tween(Card, { Position = UDim2.new(offX, 0, 0, 0) }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.3, function() Wrap:Destroy() end)
	end

	Tween(Card, { Position = UDim2.new() }, 0.45, Enum.EasingStyle.Back)
	Tween(Prog, { Size = UDim2.fromScale(0, 1) }, time, Enum.EasingStyle.Linear)
	task.delay(time, function() Notif:Destroy() end)
	return Notif
end

function Library:SetWatermark(text)
	if not self._wm then
		local W = New("Frame", {
			Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(0, 26), AutomaticSize = AUTO_X,
			BackgroundColor3 = "BackgroundColor", BackgroundTransparency = 0.15, Active = true, Parent = ScreenGui,
		})
		Corner(W, 10)
		AnimatedStroke(W, 1.2, 0, 60)
		Pad(W, 8, 10, 0, 0)
		List(W, 6, Enum.FillDirection.Horizontal, nil, Enum.VerticalAlignment.Center)
		do local d = New("Frame", { Size = UDim2.fromOffset(8, 8), BackgroundColor3 = "Flash", LayoutOrder = 1, Parent = W }) Round(d) end
		local L = Text({ Size = UDim2.fromOffset(0, 26), AutomaticSize = AUTO_X, TextSize = 12, FontFace = FONT_MED, LayoutOrder = 2, Parent = W })
