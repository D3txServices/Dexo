function BaseGroupbox:AddSlider(idx, info)
	info = info or {}
	local S = Element({
		Type = "Slider", Min = info.Min or 0, Max = info.Max or 100, Rounding = info.Rounding or 0,
		Suffix = info.Suffix or "", Prefix = info.Prefix or "", Callback = info.Callback, Text = info.Text or idx,
	})

	local compact = info.Compact
	-- label + value on top, thick segmented bar below
	local Holder, Line = Row(self.Container, 40, true)
	local Lbl = Text({ Size = UDim2.new(1, -70, 0, 18), Text = S.Text, TextColor3 = "SubFontColor", TextTruncate = Enum.TextTruncate.AtEnd, Visible = not compact, Parent = Line })
	local Val = Text({
		AnchorPoint = Vector2.new(compact and 0 or 1, 0), Position = compact and UDim2.new() or UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(compact and 1 or 0, compact and 0 or 70, 0, 18), TextSize = 12, FontFace = FONT_BOLD,
		TextXAlignment = compact and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right, Parent = Line,
	})

	local Track = New("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 8),
		BackgroundTransparency = 1, Parent = Line,
	})
	-- dashed remainder
	local TICKS = 18
	for i = 0, TICKS do
		New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(i / TICKS, 0, 0.5, 0), Size = UDim2.fromOffset(2, 6),
			BackgroundColor3 = "OutlineColor", BorderSizePixel = 0, Parent = Track,
		})
	end
	local Fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = "AccentColor", BorderSizePixel = 0, ZIndex = 2, Parent = Track })
	Round(Fill)
	New("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) }), Parent = Fill })
	local Knob = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(4, 14),
		BackgroundColor3 = WHITE, ZIndex = 3, Parent = Track,
	})
	Corner(Knob, 2)
	local KnobGlow = Stroke(Knob, "AccentColor", 3, 0.6)
	local Hit = Btn({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 20), ZIndex = 4, Parent = Track })
	Hit.MouseEnter:Connect(function() Tween(KnobGlow, { Transparency = 0.2 }, 0.15) end)
	Hit.MouseLeave:Connect(function() Tween(KnobGlow, { Transparency = 0.6 }, 0.15) end)

	local function RoundV(v)
		local m = 10 ^ S.Rounding
		return math.floor(v * m + 0.5) / m
	end

	local function Fmt(v)
		if info.FormatDisplayValue then
			local r = info.FormatDisplayValue(S, v)
			if r ~= nil then return tostring(r) end
		end
		local str = S.Rounding > 0 and string.format("%." .. S.Rounding .. "f", v) or tostring(math.floor(v + 0.5))
		local out = S.Prefix .. str .. S.Suffix
		if compact then out = S.Text .. ": " .. out end
		return out
	end

	local function Render(instant)
		local pct = (S.Max == S.Min) and 0 or (S.Value - S.Min) / (S.Max - S.Min)
		local t = instant and 0 or 0.08
		Tween(Fill, { Size = UDim2.fromScale(pct, 1) }, t)
		Tween(Knob, { Position = UDim2.fromScale(pct, 0.5) }, t)
		Val.Text = Fmt(S.Value)
	end

	function S:SetValue(v)
		v = RoundV(math.clamp(tonumber(v) or self.Min, self.Min, self.Max))
		if v == self.Value then return end
		self.Value = v
		Render()
		self:_fire()
	end
	function S:SetMin(m) self.Min = m self.Value = math.clamp(self.Value, m, self.Max) Render(true) end
	function S:SetMax(m) self.Max = m self.Value = math.clamp(self.Value, self.Min, m) Render(true) end
	function S:SetPrefix(p) self.Prefix = p Render(true) end
	function S:SetSuffix(s) self.Suffix = s Render(true) end

	S.Value = RoundV(math.clamp(info.Default or S.Min, S.Min, S.Max))

	local dragging = false
	local function DragTo(x)
		local pct = math.clamp((x - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
		S:SetValue(S.Min + (S.Max - S.Min) * pct)
	end
	Hit.InputBegan:Connect(function(input)
		if IsClick(input) and not S.Disabled then
			dragging = true
			Tween(Knob, { Size = UDim2.fromOffset(5, 18) }, 0.12)
			DragTo(input.Position.X)
		end
	end)
	Connect(UIS.InputChanged, function(input)
		if dragging and IsMove(input) then DragTo(input.Position.X) end
	end)
	Connect(UIS.InputEnded, function(input)
		if dragging and IsClick(input) then
			dragging = false
			Tween(Knob, { Size = UDim2.fromOffset(4, 14) }, 0.12)
		end
	end)

	Common(S, Holder, Lbl, Hit, info)
	Render(true)
	Options[idx] = S
	return S
end

function BaseGroupbox:AddInput(idx, info)
	info = info or {}
	local I = Element({
		Type = "Input", Value = tostring(info.Default or ""), Callback = info.Callback,
		Numeric = info.Numeric, Finished = info.Finished, Text = info.Text or idx,
	})

	local hasTitle = info.Text ~= nil
	local Holder, Line = Row(self.Container, hasTitle and 56 or 34, true)
	local Lbl
	if hasTitle then
		Lbl = Text({ Size = UDim2.new(1, 0, 0, 18), Text = info.Text, TextColor3 = "SubFontColor", TextTruncate = Enum.TextTruncate.AtEnd, Parent = Line })
	end
	local Box = New("TextBox", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = "ComponentColor", BackgroundTransparency = 0, Text = I.Value,
		PlaceholderText = info.Placeholder or "", PlaceholderColor3 = "SubFontColor", TextColor3 = "FontColor",
		FontFace = FONT_MED, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = info.ClearTextOnFocus ~= false, ClipsDescendants = true, TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = Line,
	})
	Corner(Box, 9)
	Pad(Box, 12, 12, 0, 0)
	local st = Stroke(Box, "OutlineColor", 1, 0.5)

	function I:SetValue(v)
		v = tostring(v)
		if Box.Text ~= v then Box.Text = v end
		if v == self.Value then return end
		self.Value = v
		self:_fire()
	end

	local last = I.Value
	Box:GetPropertyChangedSignal("Text"):Connect(function()
		local t = Box.Text
		if I.Numeric and t ~= "" and t ~= "-" and t ~= "." and not tonumber(t) then
			Box.Text = last
			return
		end
		if info.MaxLength and #t > info.MaxLength then
			Box.Text = t:sub(1, info.MaxLength)
			return
		end
		last = t
		if not I.Finished then I:SetValue(t) end
	end)
	Box.Focused:Connect(function() st.Color = Scheme.AccentColor end)
	Box.FocusLost:Connect(function(enter)
		st.Color = Scheme.OutlineColor
		if I.Finished then
			if enter then I:SetValue(Box.Text) else Box.Text = I.Value end
		end
	end)

	Common(I, Holder, Lbl, Box, info)
	function I:SetDisabled(d)
		self.Disabled = d
		Box.TextEditable = not d
		if Lbl then Lbl.TextTransparency = d and 0.55 or 0 end
	end
	if info.Disabled then I:SetDisabled(true) end

	Options[idx] = I
	return I
end

function BaseGroupbox:AddDropdown(idx, info)
	info = info or {}
	local DD = Element({
		Type = "Dropdown", Multi = info.Multi, Callback = info.Callback, Text = info.Text,
		AllowNull = info.AllowNull, DisabledValues = info.DisabledValues or {}, SpecialType = info.SpecialType,
	})

	local function PlayerNames()
		local out = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if not (info.ExcludeLocalPlayer and p == LocalPlayer) then table.insert(out, p.Name) end
		end
		table.sort(out)
		return out
	end
	local function TeamNames()
		local out = {}
		for _, t in ipairs(game:GetService("Teams"):GetTeams()) do table.insert(out, t.Name) end
		table.sort(out)
		return out
	end

	if info.SpecialType == "Player" then
		DD.Values = PlayerNames()
	elseif info.SpecialType == "Team" then
		DD.Values = TeamNames()
	else
		DD.Values = info.Values or {}
	end

	local function Fmt(v)
		if info.FormatDisplayValue then
			local r = info.FormatDisplayValue(v)
			if r ~= nil then return tostring(r) end
		end
		return tostring(v)
	end

	local function Resolve(v)
		if type(v) == "number" and type(DD.Values[1]) ~= "number" then return DD.Values[v] end
		return v
	end

	if DD.Multi then
		DD.Value = {}
		if type(info.Default) == "table" then
			for k, v in pairs(info.Default) do
				if type(k) == "number" then DD.Value[v] = true elseif v then DD.Value[k] = true end
			end
		elseif info.Default ~= nil then
			local k = Resolve(info.Default)
			if k ~= nil then DD.Value[k] = true end
		end
	else
		DD.Value = Resolve(info.Default)
		if DD.Value == nil and not info.AllowNull and info.Default ~= nil then DD.Value = DD.Values[1] end
	end

	local hasTitle = info.Text ~= nil
	local Holder, Line = Row(self.Container, hasTitle and 56 or 34, true)
	local Lbl
	if hasTitle then
		Lbl = Text({ Size = UDim2.new(1, 0, 0, 18), Text = info.Text, TextColor3 = "SubFontColor", TextTruncate = Enum.TextTruncate.AtEnd, Parent = Line })
	end
	local Main = Btn({
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 0, BackgroundColor3 = "ComponentColor", Parent = Line,
	})
	Corner(Main, 9)
	local mStroke = Stroke(Main, "OutlineColor", 1, 0.5)
	local Display = Text({
		Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -40, 1, 0), TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = Main,
	})
	local Arrow = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1, Parent = Main,
	})
	Chevron(Arrow, 10)

	local ListFrame = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundColor3 = "ComponentColor",
		BackgroundTransparency = 0.15, Visible = false, LayoutOrder = NextOrder(), Parent = Holder,
	})
	Corner(ListFrame, 10)
	Stroke(ListFrame, "OutlineColor", 1, 0.4)
	Pad(ListFrame, 5, 5, 5, 5)
	List(ListFrame, 4)

	local Search
	if info.Searchable then
		Search = New("TextBox", {
			Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = "MainColor", BackgroundTransparency = 0.2,
			PlaceholderText = "Search...", PlaceholderColor3 = "SubFontColor", Text = "", ClearTextOnFocus = false,
			FontFace = FONT_MED, TextSize = 12, TextColor3 = "FontColor", TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 0, Parent = ListFrame,
		})
		Corner(Search, 4)
		Pad(Search, 8, 8, 0, 0)
	end

	local Scroll = New("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 2, ScrollBarImageColor3 = "AccentColor", CanvasSize = UDim2.new(),
		AutomaticCanvasSize = AUTO_Y, LayoutOrder = 1, Parent = ListFrame,
	})
	List(Scroll, 2)

	local open = false

	local function IsSelected(v)
		if DD.Multi then return DD.Value[v] == true end
		return DD.Value == v
	end

	local function Rebuild()
		for _, child in ipairs(Scroll:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		local q = Search and Search.Text:lower() or ""
		local count = 0
		local enabled, disabled = {}, {}
		for _, v in ipairs(DD.Values) do
			table.insert(table.find(DD.DisabledValues, v) and disabled or enabled, v)
		end
		for _, v in ipairs(disabled) do table.insert(enabled, v) end

		for _, v in ipairs(enabled) do
			local shown = Fmt(v)
			if q == "" or shown:lower():find(q, 1, true) then
				count += 1
				local dis = table.find(DD.DisabledValues, v) ~= nil
				local sel = IsSelected(v)
				local Item = Btn({
					Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = sel and 0.4 or 1,
					BackgroundColor3 = "MainColor", LayoutOrder = count, Parent = Scroll,
				})
				Corner(Item, 7)
				Text({
					Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = shown, TextSize = 12,
					TextColor3 = function()
						if dis then return Scheme.OutlineColor end
						return IsSelected(v) and Scheme.AccentColor or Scheme.SubFontColor
					end,
					Parent = Item,
				})
				if sel then
					local bar = New("Frame", { Size = UDim2.new(0, 2, 0.6, 0), Position = UDim2.new(0, 2, 0.2, 0), BackgroundColor3 = "AccentColor", BorderSizePixel = 0, Parent = Item })
					Round(bar)
				end
				Item.MouseEnter:Connect(function() if not sel and not dis then Tween(Item, { BackgroundTransparency = 0.6 }, 0.12) end end)
				Item.MouseLeave:Connect(function() if not sel then Tween(Item, { BackgroundTransparency = 1 }, 0.12) end end)
				Item.MouseButton1Click:Connect(function()
					if dis or DD.Disabled then return end
					if DD.Multi then
						local new = table.clone(DD.Value)
						new[v] = (not new[v]) or nil
						DD:SetValue(new)
					else
						if DD.Value == v and DD.AllowNull then
							DD:SetValue(nil)
						else
							DD:SetValue(v)
						end
						DD:Close()
					end
				end)
			end
		end

		local maxItems = info.MaxVisibleDropdownItems or 8
		Scroll.Size = UDim2.new(1, 0, 0, math.max(0, math.min(count, maxItems) * 28 - 2))
	end

	local function DisplayText()
		if DD.Multi then
			local parts = {}
			for _, v in ipairs(DD.Values) do
				if DD.Value[v] then table.insert(parts, Fmt(v)) end
			end
			return #parts > 0 and table.concat(parts, ", ") or "None"
		end
		if DD.Value == nil then return "None" end
		return Fmt(DD.Value)
	end

	local function Refresh()
		Display.Text = DisplayText()
		if open then Rebuild() end
	end

	function DD:SetValue(v)
		if self.Multi then
			local t = {}
			if type(v) == "table" then
				for k, x in pairs(v) do
					if type(k) == "number" then t[x] = true elseif x then t[k] = true end
				end
			end
			self.Value = t
		else
			self.Value = Resolve(v)
		end
		Refresh()
		self:_fire()
	end

	function DD:SetValues(values)
		self.Values = values or {}
		Refresh()
	end
	function DD:GetActiveValues()
		if not self.Multi then return self.Value ~= nil and 1 or 0 end
		local n = 0
		for _ in pairs(self.Value) do n += 1 end
		return n
	end
	function DD:AddValues(values)
		for _, v in ipairs(type(values) == "table" and values or { values }) do table.insert(self.Values, v) end
		Refresh()
	end
	function DD:SetDisabledValues(values)
		self.DisabledValues = values or {}
		Refresh()
	end
	function DD:Open()
		open = true
		Rebuild()
		ListFrame.Visible = true
		Tween(Arrow, { Rotation = 180 })
		ListFrame.BackgroundColor3 = Scheme.MainColor
		mStroke.Color = Scheme.AccentColor
	end
	function DD:Close()
		open = false
		ListFrame.Visible = false
		Tween(Arrow, { Rotation = 0 })
		mStroke.Color = Scheme.OutlineColor
	end

	Main.MouseButton1Click:Connect(function()
		if DD.Disabled then return end
		if open then DD:Close() else DD:Open() end
	end)
	if Search then Search:GetPropertyChangedSignal("Text"):Connect(Rebuild) end

	if info.SpecialType == "Player" then
		Connect(Players.PlayerAdded, function() DD:SetValues(PlayerNames()) end)
		Connect(Players.PlayerRemoving, function() task.defer(function() DD:SetValues(PlayerNames()) end) end)
	elseif info.SpecialType == "Team" then
		local Teams = game:GetService("Teams")
		Connect(Teams.ChildAdded, function() DD:SetValues(TeamNames()) end)
		Connect(Teams.ChildRemoved, function() DD:SetValues(TeamNames()) end)
	end

	Common(DD, Holder, Lbl, Main, info)
	Refresh()
	Options[idx] = DD
	return DD
end

