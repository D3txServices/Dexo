local function NextOrder()
	Library._order += 1
	return Library._order
end

local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library._conns, c)
	return c
end

local function Register(inst, prop, key)
	table.insert(Library.Registry, { inst, prop, key })
end

-- string colour values that name a Scheme key get registered for theme updates,
-- "Flash" = accent that flashes white like the logo, functions = computed colours
local function New(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			local isColor = type(k) == "string" and k:find("Color") ~= nil and class ~= "UIGradient"
			if isColor and v == "Flash" then
				table.insert(Library.Flashing, { inst, k })
				inst[k] = Scheme.AccentColor
			elseif isColor and type(v) == "string" and Scheme[v] ~= nil then
				Register(inst, k, v)
				inst[k] = Scheme[v]
			elseif isColor and type(v) == "function" then
				Register(inst, k, v)
				inst[k] = v()
			else
				inst[k] = v
			end
		end
	end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end

local function Tween(obj, props, time, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function Corner(parent, r)
	return New("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = parent })
end

local function Round(parent)
	return New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

local function Stroke(parent, color, thickness, transparency)
	return New("UIStroke", {
		Color = color or "OutlineColor",
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

-- running accent streaks around a border (one shared loop drives all of them)
local Streaks = {}
local function AnimatedStroke(parent, thickness, transparency, speed)
	local st = New("UIStroke", {
		Color = "AccentColor", Thickness = thickness or 1.5, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent,
	})
	local g = New("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(0.18, 0),
			NumberSequenceKeypoint.new(0.36, 0.85), NumberSequenceKeypoint.new(0.64, 0.85),
			NumberSequenceKeypoint.new(0.82, 0), NumberSequenceKeypoint.new(1, 0.85),
		}),
		Rotation = math.random(0, 359), Parent = st,
	})
	table.insert(Streaks, { g, speed or 60 })
	return st, g
end
Connect(RunService.RenderStepped, function(dt)
	for _, e in ipairs(Streaks) do
		if e[1].Parent then e[1].Rotation = (e[1].Rotation + dt * e[2]) % 360 end
	end
end)

-- soft glow: stacked faint accent strokes just outside the frame
local Glows = {}
local function Glow(parent, radius, layers, strength)
	local out = {}
	for i = 1, layers or 3 do
		local f = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, i * 4, 1, i * 4),
			BackgroundTransparency = 1, ZIndex = math.max(0, parent.ZIndex - 1), Parent = parent,
		})
		New("UICorner", { CornerRadius = UDim.new(0, (radius or 10) + i * 2), Parent = f })
		local st = New("UIStroke", { Color = "AccentColor", Thickness = 2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f })
		table.insert(out, { st, (strength or 0.55) / i })
	end
	table.insert(Glows, out)
	return out
end
local glowT = 0
Connect(RunService.RenderStepped, function(dt)
	glowT += dt
	local pulse = 0.75 + math.sin(glowT * 2.2) * 0.25
	for _, set in ipairs(Glows) do
		for _, l in ipairs(set) do
			if l[1].Parent then l[1].Transparency = 1 - l[2] * pulse * (l.mult or 1) end
		end
	end
end)

-- icons drawn with frames (the font has no glyphs for chevrons, magnifier, etc.)
local function Line(parent, pos, size, rot, color)
	local f = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = size, Rotation = rot or 0,
		BackgroundColor3 = color or "SubFontColor", BorderSizePixel = 0, Parent = parent,
	})
	New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = f })
	return f
end
local function Chevron(parent, size, color)
	local c = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size or 10, size or 10),
		BackgroundTransparency = 1, Parent = parent,
	})
	local w = (size or 10) * 0.62
	Line(c, UDim2.new(0.33, 0, 0.5, 0), UDim2.fromOffset(w, 2), 45, color)
	Line(c, UDim2.new(0.67, 0, 0.5, 0), UDim2.fromOffset(w, 2), -45, color)
	return c
end
