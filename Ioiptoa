	},
	ThemeOrder = { "Dexo", "Obsidian", "Sakura", "Mint", "Ocean", "Gold", "Mono" },
}
Library.ThemeManager = ThemeManager

local function EnsureFolder(path)
	if not HasFS then return end
	local acc = ""
	for part in path:gmatch("[^/]+") do
		acc = acc == "" and part or (acc .. "/" .. part)
		pcall(function() if not isfolder(acc) then makefolder(acc) end end)
	end
end

function ThemeManager:SetLibrary(lib) self.Library = lib end
function ThemeManager:SetFolder(folder)
	self.Folder = folder
	EnsureFolder(folder .. "/themes")
end

function ThemeManager:ApplyTheme(theme)
	local t = type(theme) == "table" and theme or self.BuiltInThemes[theme]
	if not t then return end
	for _, k in ipairs(SCHEME_KEYS) do
		local hex = t[k]
		if hex then
			local ok, c = pcall(Color3.fromHex, hex)
			if ok and c then
				if Options[k] and Options[k].SetValueRGB then
					Options[k]:SetValueRGB(c)
				else
					Scheme[k] = c
					if k == "AccentColor" then Library.BaseAccent = c end
				end
			end
		end
	end
	Library:UpdateColors()
end

function ThemeManager:GetCurrent()
	local t = {}
	for _, k in ipairs(SCHEME_KEYS) do
		t[k] = (k == "AccentColor" and Library.BaseAccent or Scheme[k]):ToHex()
	end
	t.Rainbow = Library.Rainbow
	t.RainbowSpeed = Library.RainbowSpeed
	t.Blur = Library.BlurEnabled
	t.BlurStrength = Library.BlurIntensity
	return t
end

function ThemeManager:SaveDefault()
	if not HasFS then
		Library:Notify({ Title = "Themes", Description = "File functions aren't available here.", Time = 3 })
		return false
	end
	EnsureFolder(self.Folder .. "/themes")
	local ok = pcall(writefile, self.Folder .. "/themes/default.json", HttpService:JSONEncode(self:GetCurrent()))
	Library:Notify({ Title = "Themes", Description = ok and "Saved as your default theme." or "Couldn't save the theme.", Time = 3 })
	return ok
end

function ThemeManager:LoadDefault()
	if not HasFS then return false end
	local path = self.Folder .. "/themes/default.json"
	local ok, data = pcall(function()
		if isfile(path) then return HttpService:JSONDecode(readfile(path)) end
	end)
	if not ok or type(data) ~= "table" then return false end
	self:ApplyTheme(data)
	if Toggles.RainbowAccent and data.Rainbow ~= nil then Toggles.RainbowAccent:SetValue(data.Rainbow) end
	if Options.RainbowSpeed and data.RainbowSpeed then Options.RainbowSpeed:SetValue(math.floor(data.RainbowSpeed * 20 + 0.5)) end
	if Toggles.BackgroundBlur and data.Blur ~= nil then Toggles.BackgroundBlur:SetValue(data.Blur) end
	if Options.BlurStrength and data.BlurStrength then Options.BlurStrength:SetValue(data.BlurStrength) end
	return true
end

function ThemeManager:CreateThemeManager(groupbox)
	for _, k in ipairs(SCHEME_KEYS) do
		groupbox:AddLabel(SCHEME_NAMES[k] .. " color"):AddColorPicker(k, {
			Default = k == "AccentColor" and Library.BaseAccent or Scheme[k], Title = SCHEME_NAMES[k],
		})
		Options[k]:OnChanged(function(c)
			if k == "AccentColor" then
				Library:SetAccent(c)
			else
				Scheme[k] = c
				Library:UpdateColors()
			end
		end)
	end

	groupbox:AddDivider()
	groupbox:AddToggle("RainbowAccent", { Text = "Rainbow accent", Default = Library.Rainbow })
	groupbox:AddSlider("RainbowSpeed", { Text = "Rainbow speed", Min = 1, Max = 10, Default = math.max(1, math.floor(Library.RainbowSpeed * 20 + 0.5)), Rounding = 0 })
	groupbox:AddToggle("BackgroundBlur", { Text = "Background blur", Default = Library.BlurEnabled })
	groupbox:AddSlider("BlurStrength", { Text = "Blur strength", Min = 0, Max = 1, Default = Library.BlurIntensity, Rounding = 2 })

	Toggles.RainbowAccent:OnChanged(function(v)
		Library.Rainbow = v
		if not v then
			Scheme.AccentColor = Library.BaseAccent
			Library:UpdateColors()
		end
	end)
	Options.RainbowSpeed:OnChanged(function(v) Library.RainbowSpeed = v / 20 end)
	Toggles.BackgroundBlur:OnChanged(function(v) Library.BlurEnabled = v end)
	Options.BlurStrength:OnChanged(function(v) Library.BlurIntensity = v end)

	groupbox:AddDivider()
	groupbox:AddDropdown("ThemeManager_ThemeList", { Text = "Preset", Values = self.ThemeOrder, Default = 1 })
	groupbox:AddButton("Apply preset", function()
		self:ApplyTheme(Options.ThemeManager_ThemeList.Value)
	end):AddButton("Set as default", function()
		self:SaveDefault()
	end)

	self:LoadDefault()
end

function ThemeManager:ApplyToGroupbox(groupbox)
	self:CreateThemeManager(groupbox)
end

function ThemeManager:ApplyToTab(tab)
	self:CreateThemeManager(tab:AddLeftGroupbox("Themes"))
end

