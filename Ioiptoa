local SaveManager = {
	Library = Library,
	Folder = "DexoHub",
	SubFolder = "",
	Ignore = {},
}
Library.SaveManager = SaveManager

local Parser = {
	Toggle = {
		Save = function(idx, o) return { type = "Toggle", idx = idx, value = o.Value } end,
		Load = function(idx, d) if Toggles[idx] then Toggles[idx]:SetValue(d.value) end end,
	},
	Slider = {
		Save = function(idx, o) return { type = "Slider", idx = idx, value = tostring(o.Value) } end,
		Load = function(idx, d) if Options[idx] then Options[idx]:SetValue(tonumber(d.value)) end end,
	},
	Dropdown = {
		Save = function(idx, o) return { type = "Dropdown", idx = idx, value = o.Value, multi = o.Multi } end,
		Load = function(idx, d) if Options[idx] then Options[idx]:SetValue(d.value) end end,
	},
	ColorPicker = {
		Save = function(idx, o) return { type = "ColorPicker", idx = idx, value = o.Value:ToHex(), transparency = o.Transparency } end,
		Load = function(idx, d) if Options[idx] then Options[idx]:SetValueRGB(Color3.fromHex(d.value), d.transparency) end end,
	},
	KeyPicker = {
		Save = function(idx, o) return { type = "KeyPicker", idx = idx, mode = o.Mode, key = o.Value } end,
		Load = function(idx, d) if Options[idx] then Options[idx]:SetValue({ d.key, d.mode }) end end,
	},
	Input = {
		Save = function(idx, o) return { type = "Input", idx = idx, text = o.Value } end,
		Load = function(idx, d) if Options[idx] and type(d.text) == "string" then Options[idx]:SetValue(d.text) end end,
	},
}

function SaveManager:SetLibrary(lib) self.Library = lib end
function SaveManager:SetFolder(folder)
	self.Folder = folder
	self:BuildFolderTree()
end
function SaveManager:SetSubFolder(sub)
	self.SubFolder = sub or ""
	self:BuildFolderTree()
end
function SaveManager:SetIgnoreIndexes(list)
	for _, v in ipairs(list) do self.Ignore[v] = true end
end
function SaveManager:IgnoreThemeSettings()
	self:SetIgnoreIndexes({
		"BackgroundColor", "MainColor", "ComponentColor", "AccentColor", "OutlineColor", "FontColor",
		"RainbowAccent", "RainbowSpeed", "BackgroundBlur", "BlurStrength", "ThemeManager_ThemeList",
	})
end

function SaveManager:Path()
	local p = self.Folder .. "/settings"
	if self.SubFolder ~= "" then p = p .. "/" .. self.SubFolder end
	return p
end

function SaveManager:BuildFolderTree()
	EnsureFolder(self.Folder .. "/themes")
	EnsureFolder(self:Path())
end

function SaveManager:Save(name)
	if not name or name == "" then return false, "no config name" end
	if not HasFS then return false, "file functions unavailable" end
	self:BuildFolderTree()
	local data = { objects = {} }
	for idx, t in pairs(Toggles) do
		if not self.Ignore[idx] then table.insert(data.objects, Parser.Toggle.Save(idx, t)) end
	end
	for idx, o in pairs(Options) do
		if not self.Ignore[idx] and Parser[o.Type] then
			table.insert(data.objects, Parser[o.Type].Save(idx, o))
		end
	end
	local ok, err = pcall(function()
		writefile(self:Path() .. "/" .. name .. ".json", HttpService:JSONEncode(data))
	end)
	if not ok then return false, tostring(err) end
	return true
end

function SaveManager:Load(name)
	if not name or name == "" then return false, "no config selected" end
	if not HasFS then return false, "file functions unavailable" end
	local path = self:Path() .. "/" .. name .. ".json"
	local ok, data = pcall(function()
		if isfile(path) then return HttpService:JSONDecode(readfile(path)) end
	end)
	if not ok or type(data) ~= "table" or type(data.objects) ~= "table" then return false, "invalid file" end
	for _, obj in ipairs(data.objects) do
		local p = Parser[obj.type]
		if p and not self.Ignore[obj.idx] then
			task.spawn(function() pcall(p.Load, obj.idx, obj) end)
		end
	end
	return true
end

function SaveManager:Delete(name)
	if not (HasFS and CanDelete) or not name or name == "" then return false end
	local path = self:Path() .. "/" .. name .. ".json"
	return pcall(function() if isfile(path) then delfile(path) end end)
end

function SaveManager:RefreshConfigList()
	local out = {}
	if not HasFS then return out end
	self:BuildFolderTree()
	local ok, files = pcall(listfiles, self:Path())
	if not ok or type(files) ~= "table" then return out end
	for _, f in ipairs(files) do
		local file = tostring(f):match("([^/\\]+)$") or tostring(f)
		local nm = file:match("^(.+)%.json$")
		if nm then table.insert(out, nm) end
	end
	table.sort(out)
	return out
end

function SaveManager:GetAutoloadConfig()
	if not HasFS then return nil end
	local path = self:Path() .. "/autoload.txt"
	local ok, name = pcall(function()
		if isfile(path) then return readfile(path) end
	end)
	if ok and name and name ~= "" then return name end
	return nil
end

function SaveManager:SaveAutoloadConfig(name)
	if not HasFS then return false end
	return pcall(writefile, self:Path() .. "/autoload.txt", name)
end

function SaveManager:DeleteAutoLoadConfig()
	if not HasFS then return false end
	local path = self:Path() .. "/autoload.txt"
	if CanDelete then
		return pcall(function() if isfile(path) then delfile(path) end end)
	end
	return pcall(writefile, path, "")
end

function SaveManager:LoadAutoloadConfig()
	local name = self:GetAutoloadConfig()
	if not name then return end
	local ok, err = self:Load(name)
	if ok then
		Library:Notify({ Title = "Config", Description = "Auto loaded <b>" .. name .. "</b>", Time = 3 })
	else
		Library:Notify({ Title = "Config", Description = "Autoload failed: " .. tostring(err), Time = 4 })
	end
end

function SaveManager:BuildConfigSection(tab)
	local gb = tab:AddRightGroupbox("Configuration")
	if not HasFS then
		gb:AddLabel("<font color='#ff5050'>Your executor has no file functions, so configs are off.</font>", true)
	end

	gb:AddInput("SaveManager_ConfigName", { Text = "Config name", Placeholder = "my config" })
	gb:AddButton("Create config", function()
		local name = Options.SaveManager_ConfigName.Value
		if name:gsub(" ", "") == "" then
			return Library:Notify({ Title = "Config", Description = "Type a config name first.", Time = 3 })
		end
		local ok, err = self:Save(name)
		Library:Notify({ Title = "Config", Description = ok and ("Created <b>" .. name .. "</b>") or ("Failed: " .. tostring(err)), Time = 3 })
		Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
		Options.SaveManager_ConfigList:SetValue(nil)
	end)

	gb:AddDivider()
	gb:AddDropdown("SaveManager_ConfigList", { Text = "Config list", Values = self:RefreshConfigList(), AllowNull = true })
	gb:AddButton("Load config", function()
		local name = Options.SaveManager_ConfigList.Value
		local ok, err = self:Load(name)
		Library:Notify({ Title = "Config", Description = ok and ("Loaded <b>" .. tostring(name) .. "</b>") or ("Failed: " .. tostring(err)), Time = 3 })
	end):AddButton("Overwrite", function()
		local name = Options.SaveManager_ConfigList.Value
		local ok, err = self:Save(name)
		Library:Notify({ Title = "Config", Description = ok and ("Saved <b>" .. tostring(name) .. "</b>") or ("Failed: " .. tostring(err)), Time = 3 })
	end)
	gb:AddButton({
		Text = "Delete config", DoubleClick = true, Risky = true,
		Func = function()
			local name = Options.SaveManager_ConfigList.Value
			self:Delete(name)
			Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
			Options.SaveManager_ConfigList:SetValue(nil)
		end,
	}):AddButton("Refresh list", function()
		Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
		Options.SaveManager_ConfigList:SetValue(nil)
	end)

	local AutoLbl = gb:AddLabel("Autoload: " .. (self:GetAutoloadConfig() or "none"), true)
	gb:AddButton("Set as autoload", function()
		local name = Options.SaveManager_ConfigList.Value
		if not name then return end
		self:SaveAutoloadConfig(name)
		AutoLbl:SetText("Autoload: " .. name)
		Library:Notify({ Title = "Config", Description = "<b>" .. name .. "</b> will load automatically.", Time = 3 })
	end):AddButton("Reset autoload", function()
		self:DeleteAutoLoadConfig()
		AutoLbl:SetText("Autoload: none")
	end)

	self:SetIgnoreIndexes({ "SaveManager_ConfigList", "SaveManager_ConfigName" })
end

