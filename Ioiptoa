local function Row(container, height, noAddons)
	local Holder = New("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y,
		LayoutOrder = NextOrder(), Parent = container,
	})
	List(Holder, 6)
	local Line = New("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or 0),
		AutomaticSize = height and AUTO_NONE or AUTO_Y, LayoutOrder = 0, Parent = Holder,
	})
	local Addons
	if not noAddons then
		Addons = New("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 0, 1, 0), AutomaticSize = AUTO_X, ZIndex = 3, Parent = Line,
		})
		List(Addons, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	end
	return Holder, Line, Addons
end

local function Common(obj, Holder, Lbl, hover, info)
	function obj:SetVisible(v)
		self.Visible = v
		Holder.Visible = v
		Holder:SetAttribute("UserHidden", not v)
	end
	function obj:SetText(t)
		self.Text = t
		if Lbl then Lbl.Text = t end
	end
	function obj:SetDisabled(d)
		self.Disabled = d
		if Lbl then Lbl.TextTransparency = d and 0.55 or 0 end
	end
	function obj:SetTooltip(t) info.Tooltip = t end
	obj.Holder = Holder
	obj:SetVisible(info.Visible ~= false)
	if info.Disabled then obj:SetDisabled(true) end
	if hover then
		AddTooltip(hover, function()
			if obj.Disabled then return info.DisabledTooltip end
			return info.Tooltip
		end)
	end
end

local CreateColorPicker, CreateKeyPicker

local function WithAddons(obj, Holder, Addons)
	function obj:AddColorPicker(idx, info)
		CreateColorPicker(self, Holder, Addons, idx, info or {})
		return self
	end
	function obj:AddKeyPicker(idx, info)
		CreateKeyPicker(self, Holder, Addons, idx, info or {})
		return self
	end
	return obj
end

-- colorpicker ---------------------------------------------------------------

CreateColorPicker = function(_, Holder, Addons, idx, info)
	local CP = Element({
		Type = "ColorPicker", Value = info.Default or WHITE, Transparency = info.Transparency or 0,
		Callback = info.Callback, Title = info.Title,
	})
	local H, S, V = CP.Value:ToHSV()
	local hasAlpha = info.Transparency ~= nil

	-- pill swatch with an outline, like the "Accent color" control
	local Swatch = Btn({
		Size = UDim2.fromOffset(30, 18), BackgroundTransparency = 0, BackgroundColor3 = CP.Value,
		LayoutOrder = NextOrder(), Parent = Addons,
	})
	Round(Swatch)
	local swStroke = Stroke(Swatch, "OutlineColor", 2)

	-- floating popup -------------------------------------------------------
	local Pop = New("Frame", {
		Size = UDim2.fromOffset(232, 0), AutomaticSize = AUTO_Y, BackgroundColor3 = "BackgroundColor",
		BackgroundTransparency = 0.02, Visible = false, ZIndex = 400, Active = true, Parent = ScreenGui,
	})
	Corner(Pop, 14)
	AnimatedStroke(Pop, 1.4, 0, 80)
	local PopScale = New("UIScale", { Scale = Library.DPIScale, Parent = Pop })
	Pad(Pop, 14, 14, 10, 14)
	List(Pop, 10)

	-- mode tabs
	local Modes = New("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, ZIndex = 401, LayoutOrder = 1, Parent = Pop })
	List(Modes, 0, Enum.FillDirection.Horizontal)
	local mode = "HEX"
	local modeBtns = {}
	for i, m in ipairs({ "HEX", "RGB", "HSV" }) do
		local b = Btn({ Size = UDim2.new(1 / 3, 0, 1, 0), Text = m, TextSize = 12, FontFace = FONT_BOLD, ZIndex = 402, LayoutOrder = i, Parent = Modes,
			TextColor3 = function() return mode == m and Scheme.FontColor or Scheme.SubFontColor end })
		local u = New("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0.5, 0, 0, 2),
			BackgroundColor3 = "AccentColor", BorderSizePixel = 0, Visible = m == mode, ZIndex = 402, Parent = b })
		modeBtns[m] = { b, u }
	end

	local SV = New("Frame", { Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = Color3.fromHSV(H, 1, 1), ZIndex = 401, LayoutOrder = 2, Parent = Pop })
	Corner(SV, 10)
	local W = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, ZIndex = 401, Parent = SV })
	Corner(W, 10)
	New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = W })
	local B = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 402, Parent = SV })
	Corner(B, 10)
	New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = B })
	local SVCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ZIndex = 404, Parent = SV })
	Round(SVCursor)
	Stroke(SVCursor, "White", 3)

	local function Bar(order)
		local f = New("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = WHITE, ZIndex = 401, LayoutOrder = order, Parent = Pop })
		Round(f)
		local k = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(6, 16), BackgroundColor3 = WHITE, ZIndex = 403, Parent = f })
		Corner(k, 3)
		Stroke(k, "BackgroundColor", 1)
		return f, k
	end
	local Hue, HueKnob = Bar(3)
	do
		local kp = {}
		for i = 0, 6 do kp[#kp + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 % 1, 1, 1)) end
		New("UIGradient", { Color = ColorSequence.new(kp), Parent = Hue })
	end
	local Alpha, AlphaKnob, AlphaGrad
	if hasAlpha then
		Alpha, AlphaKnob = Bar(4)
		AlphaGrad = New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = Alpha })
	end

	local Field = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = "ComponentColor", ZIndex = 401, LayoutOrder = 5, Parent = Pop })
	Corner(Field, 10)
	local Input = New("TextBox", {
		Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -46, 1, 0), BackgroundTransparency = 1, Text = "",
		FontFace = FONT_MED, TextSize = 13, TextColor3 = "FontColor", TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false, ZIndex = 402, Parent = Field,
	})
	local CopyB = Btn({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(24, 24),
		Text = "", ZIndex = 402, Parent = Field })
	do local a = BoxIcon(CopyB, -2) a.ZIndex = 403 local b2 = BoxIcon(CopyB, 2) b2.ZIndex = 403 end

	local function FieldText()
		local c = CP.Value
		if mode == "RGB" then
			return ("%d, %d, %d"):format(math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
		elseif mode == "HSV" then
			return ("%d, %d, %d"):format(math.floor(H * 360 + 0.5), math.floor(S * 100 + 0.5), math.floor(V * 100 + 0.5))
		end
		return "#" .. c:ToHex():upper()
	end

	local function Render()
		CP.Value = Color3.fromHSV(H, S, V)
		Swatch.BackgroundColor3 = CP.Value
		Swatch.BackgroundTransparency = CP.Transparency
		SV.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
		SVCursor.Position = UDim2.fromScale(S, 1 - V)
		HueKnob.Position = UDim2.fromScale(H, 0.5)
		if Alpha then
			Alpha.BackgroundColor3 = CP.Value
			AlphaKnob.Position = UDim2.fromScale(CP.Transparency, 0.5)
		end
		if not Input:IsFocused() then Input.Text = FieldText() end
	end

	for m, pair in pairs(modeBtns) do
		pair[1].MouseButton1Click:Connect(function()
			mode = m
			for k, p in pairs(modeBtns) do
				p[2].Visible = k == m
				p[1].TextColor3 = k == m and Scheme.FontColor or Scheme.SubFontColor
			end
			Render()
		end)
	end

	function CP:SetValueRGB(color, transparency)
		H, S, V = color:ToHSV()
		if transparency then self.Transparency = transparency end
		Render()
		self:_fire()
	end
	function CP:SetValue(hsv, transparency)
		if typeof(hsv) == "Color3" then return self:SetValueRGB(hsv, transparency) end
		H, S, V = hsv[1], hsv[2], hsv[3]
		if transparency then self.Transparency = transparency end
		Render()
		self:_fire()
	end
	function CP:SetVisible(v) Swatch.Visible = v end

	local drag
	local function Drag()
		local m = MousePos()
		if drag == "sv" then
			S = math.clamp((m.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
			V = 1 - math.clamp((m.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
		elseif drag == "hue" then
			H = math.clamp((m.X - Hue.AbsolutePosition.X) / Hue.AbsoluteSize.X, 0, 0.999)
		elseif drag == "alpha" then
			CP.Transparency = math.clamp((m.X - Alpha.AbsolutePosition.X) / Alpha.AbsoluteSize.X, 0, 1)
		end
		Render()
		CP:_fire()
	end
	local function HitFor(frame, m)
		local hit = Btn({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 8, 1, 10), ZIndex = 405, Parent = frame })
		hit.InputBegan:Connect(function(i) if IsClick(i) then drag = m Drag() end end)
	end
	HitFor(SV, "sv")
	HitFor(Hue, "hue")
	if Alpha then HitFor(Alpha, "alpha") end
	Connect(UIS.InputChanged, function(i) if drag and IsMove(i) then Drag() end end)
	Connect(UIS.InputEnded, function(i) if IsClick(i) then drag = nil end end)

	Input.FocusLost:Connect(function()
		local t = Input.Text
		local c
		if mode == "HEX" then
			local ok, r = pcall(Color3.fromHex, (t:gsub("#", "")))
			if ok then c = r end
		else
			local a, b2, d = t:match("(%d+)%D+(%d+)%D+(%d+)")
			a, b2, d = tonumber(a), tonumber(b2), tonumber(d)
			if a and b2 and d then
				if mode == "RGB" then c = Color3.fromRGB(math.clamp(a, 0, 255), math.clamp(b2, 0, 255), math.clamp(d, 0, 255))
				else c = Color3.fromHSV(math.clamp(a, 0, 360) / 360 % 1, math.clamp(b2, 0, 100) / 100, math.clamp(d, 0, 100) / 100) end
			end
		end
		if c then CP:SetValueRGB(c) else Render() end
	end)
	CopyB.MouseButton1Click:Connect(function()
		local f = setclipboard or toclipboard or (syn and syn.write_clipboard)
		if f then pcall(f, FieldText()) Library:Notify({ Title = "Copied", Description = FieldText(), Time = 2 }) end
	end)

	local function Place()
		local sp = Swatch.AbsolutePosition
		local ss = Swatch.AbsoluteSize
		local scr = ScreenGui.AbsoluteSize
		PopScale.Scale = Library.DPIScale
		local w, h = Pop.AbsoluteSize.X, Pop.AbsoluteSize.Y
		local x = math.clamp(sp.X + ss.X - w, 8, scr.X - w - 8)
		local y = sp.Y + ss.Y + 8
		if y + h > scr.Y - 8 then y = math.max(8, sp.Y - h - 8) end
		Pop.Position = UDim2.fromOffset(x, y)
	end
	local function Close()
		Pop.Visible = false
		swStroke.Color = Scheme.OutlineColor
	end
	Swatch.MouseButton1Click:Connect(function()
		if Pop.Visible then return Close() end
		Pop.Visible = true
		swStroke.Color = Scheme.AccentColor
		Render()
		Place()
		task.defer(Place)
	end)
	-- click outside closes
	Connect(UIS.InputBegan, function(i)
		if not Pop.Visible or not IsClick(i) then return end
		local m = MousePos()
		local function inside(g)
			local p, s = g.AbsolutePosition, g.AbsoluteSize
			return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
		end
		if not inside(Pop) and not inside(Swatch) then Close() end
	end)
	Connect(Swatch:GetPropertyChangedSignal("AbsolutePosition"), function() if Pop.Visible then Place() end end)
	Library._popClosers = Library._popClosers or {}
	table.insert(Library._popClosers, Close)
	Library:OnUnload(function() Pop:Destroy() end)
	AddTooltip(Swatch, function() return info.Title end)

	Render()
	Options[idx] = CP
	return CP
end

-- keypicker -----------------------------------------------------------------

local SHORT = {
	MouseButton1 = "MB1", MouseButton2 = "MB2", MouseButton3 = "MB3",
	LeftShift = "LShift", RightShift = "RShift", LeftControl = "LCtrl", RightControl = "RCtrl",
	LeftAlt = "LAlt", RightAlt = "RAlt", Return = "Enter", CapsLock = "Caps", Insert = "Ins",
	Backspace = "Bksp", Delete = "Del", PageUp = "PgUp", PageDown = "PgDn",
}
local MOUSE = {
	MB1 = Enum.UserInputType.MouseButton1,
	MB2 = Enum.UserInputType.MouseButton2,
	MB3 = Enum.UserInputType.MouseButton3,
}

local function InputName(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.Keyboard then return input.KeyCode.Name end
	if t == Enum.UserInputType.MouseButton1 then return "MB1" end
	if t == Enum.UserInputType.MouseButton2 then return "MB2" end
	if t == Enum.UserInputType.MouseButton3 then return "MB3" end
	return nil
end

local function Pretty(key)
	return SHORT[key] or key
end

CreateKeyPicker = function(parent, Holder, Addons, idx, info)
	local default = info.Default
	if default == nil or default == "" then default = "None" end
	local KP = Element({
		Type = "KeyPicker", Value = default, Mode = info.Mode or "Toggle", Toggled = false,
		Callback = info.Callback, Text = info.Text or idx, NoUI = info.NoUI,
		SyncToggleState = info.SyncToggleState, Modifiers = {},
	})
	KP._clicks = {}

	local binding = false
	local Button = Btn({
		Size = UDim2.fromOffset(0, 18), AutomaticSize = AUTO_X, BackgroundTransparency = 0.2,
		BackgroundColor3 = "ComponentColor", TextSize = 11, TextColor3 = function()
			return binding and Scheme.AccentColor or Scheme.SubFontColor
		end, Text = Pretty(KP.Value), LayoutOrder = NextOrder(), Parent = Addons,
	})
	Corner(Button, 4)
	Pad(Button, 6, 6, 0, 0)
	local bStroke = Stroke(Button, "OutlineColor")

	-- mode picker (right click)
	local ModePanel = New("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Visible = false, LayoutOrder = NextOrder(), Parent = Holder })
	List(ModePanel, 4, Enum.FillDirection.Horizontal)
	local modeButtons = {}
	local function RefreshModes()
		for m, b in pairs(modeButtons) do
			b.TextColor3 = KP.Mode == m and Scheme.AccentColor or Scheme.SubFontColor
		end
	end
	for i, m in ipairs({ "Always", "Toggle", "Hold", "Press" }) do
		local b = Btn({
			Size = UDim2.new(0.25, -3, 1, 0), BackgroundTransparency = 0.2, BackgroundColor3 = "ComponentColor",
			Text = m, TextSize = 11, LayoutOrder = i, Parent = ModePanel,
			TextColor3 = function() return KP.Mode == m and Scheme.AccentColor or Scheme.SubFontColor end,
		})
		Corner(b, 4)
		modeButtons[m] = b
		b.MouseButton1Click:Connect(function()
			KP.Mode = m
			RefreshModes()
			ModePanel.Visible = false
		end)
	end

	function KP:GetState()
		if self.Mode == "Always" then return true end
		if self.Mode == "Toggle" then return self.Toggled end
		if self.Mode == "Hold" and self.Value ~= "None" then
			if MOUSE[self.Value] then return UIS:IsMouseButtonPressed(MOUSE[self.Value]) end
			local ok, kc = pcall(function() return Enum.KeyCode[self.Value] end)
			return ok and kc ~= nil and UIS:IsKeyDown(kc)
		end
		return false
	end

	function KP:SetValue(data)
		local key, mode = data, nil
		if type(data) == "table" then key, mode = data[1], data[2] end
		if key == nil or key == "" then key = "None" end
		self.Value = key
		if mode then self.Mode = mode RefreshModes() end
		Button.Text = Pretty(key)
		if info.ChangedCallback then task.spawn(info.ChangedCallback, key) end
		self:_fire()
	end

	function KP:OnClick(fn) table.insert(self._clicks, fn) end
	function KP:Update() Button.Text = Pretty(self.Value) end

	Button.MouseButton1Click:Connect(function()
		binding = true
		Button.Text = "..."
		Button.TextColor3 = Scheme.AccentColor
		bStroke.Color = Scheme.AccentColor
	end)
	Button.MouseButton2Click:Connect(function()
		ModePanel.Visible = not ModePanel.Visible
		RefreshModes()
	end)
	AddTooltip(Button, function() return "Click: rebind  ·  Right-click: mode  ·  Esc: clear" end)

	if KP.SyncToggleState and parent and parent.Type == "Toggle" then
		KP.Toggled = parent.Value
		parent:OnChanged(function(v) KP.Toggled = v end)
	end

	local busy = false
	Connect(UIS.InputBegan, function(input)
		if binding then
			local name = InputName(input)
			if not name then return end
			if name == "Escape" or name == "Backspace" then name = "None" end
			binding = false
			Button.TextColor3 = Scheme.SubFontColor
			bStroke.Color = Scheme.OutlineColor
			KP:SetValue(name)
			return
		end
		if KP.Value == "None" or UIS:GetFocusedTextBox() then return end
		if InputName(input) ~= KP.Value then return end

		if KP.Mode == "Toggle" then
			KP.Toggled = not KP.Toggled
			if KP.SyncToggleState and parent and parent.Type == "Toggle" then parent:SetValue(KP.Toggled) end
			if KP.Callback then task.spawn(KP.Callback, KP.Toggled) end
			for _, fn in ipairs(KP._clicks) do task.spawn(fn) end
		elseif KP.Mode == "Press" then
			if info.WaitForCallback then
				if busy then return end
				busy = true
				task.spawn(function()
					if KP.Callback then pcall(KP.Callback, true) end
					busy = false
				end)
			elseif KP.Callback then
				task.spawn(KP.Callback, true)
			end
			for _, fn in ipairs(KP._clicks) do task.spawn(fn) end
		elseif KP.Mode == "Hold" then
			if KP.Callback then task.spawn(KP.Callback, true) end
		end
	end)
	Connect(UIS.InputEnded, function(input)
		if KP.Mode == "Hold" and KP.Value ~= "None" and InputName(input) == KP.Value and KP.Callback then
			task.spawn(KP.Callback, false)
		end
	end)

	if not KP.NoUI then
		local Entry = Text({ Size = UDim2.new(1, 0, 0, 16), TextSize = 12, TextColor3 = "SubFontColor", LayoutOrder = NextOrder(), Parent = KeybindFrame })
		Connect(RunService.Heartbeat, function()
			Entry.Text = string.format("[%s]  %s  ·  %s", Pretty(KP.Value), KP.Text, KP.Mode)
			Entry.TextColor3 = KP:GetState() and Scheme.AccentColor or Scheme.SubFontColor
		end)
	end

	Options[idx] = KP
	return KP
end

