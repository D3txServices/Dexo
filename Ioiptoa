local BaseGroupbox = {}
BaseGroupbox.__index = BaseGroupbox

function BaseGroupbox:AddToggle(idx, info)
	info = info or {}
	if Library.ForceCheckbox then return self:AddCheckbox(idx, info) end

	local Holder, Line, Addons = Row(self.Container, 30)
	local Toggle = WithAddons(Element({
		Type = "Toggle", Value = info.Default == true, Text = info.Text or idx,
		Risky = info.Risky, Callback = info.Callback,
	}), Holder, Addons)

	local function LabelColor()
		if Toggle.Risky then return Scheme.Red end
		return Toggle.Value and Scheme.FontColor or Scheme.SubFontColor
	end

	local Lbl = Text({ Size = UDim2.new(1, -60, 1, 0), Text = Toggle.Text, TextColor3 = LabelColor, TextTruncate = Enum.TextTruncate.AtEnd, RichText = true, Parent = Line })

	-- pill switch: off = dark with a small "I" mark on the right, on = accent with white knob right and mark left
	local Switch = New("Frame", {
		Size = UDim2.fromOffset(36, 20), LayoutOrder = 1e9, Parent = Addons,
		BackgroundColor3 = function() return Toggle.Value and Scheme.AccentColor or Scheme.ComponentColor end,
	})
	Round(Switch)
	New("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.2, Parent = Switch,
		Color = function() return Toggle.Value and Scheme.AccentColor or Scheme.OutlineColor end,
	})
	local Mark = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 26, 0.5, 0), Size = UDim2.fromOffset(2, 8),
		BackgroundColor3 = WHITE, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = Switch,
	})
	Round(Mark)
	local Knob = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = function() return Toggle.Value and WHITE or Scheme.SubFontColor end, Parent = Switch,
	})
	Round(Knob)
	local KnobRing = Stroke(Knob, "AccentColor", 2, 1)
	local Hit = Btn({ Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = Line })

	local function Render(instant)
		local on = Toggle.Value
		local t = instant and 0 or 0.22
		Tween(Knob, { Position = on and UDim2.new(0, 26, 0.5, 0) or UDim2.new(0, 10, 0.5, 0), BackgroundColor3 = on and WHITE or Scheme.SubFontColor }, t)
		Tween(Mark, { Position = on and UDim2.new(0, 10, 0.5, 0) or UDim2.new(0, 26, 0.5, 0), BackgroundTransparency = on and 0.35 or 0.6 }, t)
		Tween(Switch, { BackgroundColor3 = on and Scheme.AccentColor or Scheme.ComponentColor }, t)
		Tween(KnobRing, { Transparency = on and 0.6 or 1 }, t)
		Tween(Lbl, { TextColor3 = LabelColor() }, t)
		Switch.UIStroke.Color = on and Scheme.AccentColor or Scheme.OutlineColor
	end

	function Toggle:SetValue(v)
		v = v == true
		if v == self.Value then return end
		self.Value = v
		Render()
		self:_fire()
	end

	Hit.MouseButton1Click:Connect(function()
		if not Toggle.Disabled then Toggle:SetValue(not Toggle.Value) end
	end)

	Common(Toggle, Holder, Lbl, Hit, info)
	Render(true)
	Toggles[idx] = Toggle
	return Toggle
end

function BaseGroupbox:AddCheckbox(idx, info)
	info = info or {}
	local Holder, Line, Addons = Row(self.Container, 26)
	local CB = WithAddons(Element({
		Type = "Toggle", Value = info.Default == true, Text = info.Text or idx,
		Risky = info.Risky, Callback = info.Callback,
	}), Holder, Addons)

	local function LabelColor()
		if CB.Risky then return Scheme.Red end
		return CB.Value and Scheme.FontColor or Scheme.SubFontColor
	end

	local Box = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = "ComponentColor", Parent = Line,
	})
	Corner(Box, 4)
	New("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Box,
		Color = function() return CB.Value and Scheme.AccentColor or Scheme.OutlineColor end,
	})
	local Fill = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = "AccentColor", Parent = Box,
	})
	Corner(Fill, 3)
	local Lbl = Text({ Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -80, 1, 0), Text = CB.Text, TextColor3 = LabelColor, Parent = Line })
	local Hit = Btn({ Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = Line })

	local function Render(instant)
		local on = CB.Value
		local t = instant and 0 or 0.2
		Tween(Fill, { Size = on and UDim2.fromOffset(10, 10) or UDim2.fromOffset(0, 0) }, t, Enum.EasingStyle.Back)
		Tween(Lbl, { TextColor3 = LabelColor() }, t)
		Box.UIStroke.Color = on and Scheme.AccentColor or Scheme.OutlineColor
	end

	function CB:SetValue(v)
		v = v == true
		if v == self.Value then return end
		self.Value = v
		Render()
		self:_fire()
	end

	Hit.MouseButton1Click:Connect(function()
		if not CB.Disabled then CB:SetValue(not CB.Value) end
	end)

	Common(CB, Holder, Lbl, Hit, info)
	Render(true)
	Toggles[idx] = CB
	return CB
end

function BaseGroupbox:AddButton(info, func)
	if type(info) == "string" then info = { Text = info, Func = func } end
	info = info or {}

	local _, Line = Row(self.Container, 32, true)
	List(Line, 6, Enum.FillDirection.Horizontal)
	local buttons = {}

	local function Layout()
		local n = #buttons
		for _, b in ipairs(buttons) do
			b.Size = UDim2.new(1 / n, -(6 * (n - 1)) / n, 1, 0)
		end
	end

	local function Make(binfo)
		local Button = { Text = binfo.Text or "Button", Disabled = binfo.Disabled, Type = "Button" }
		local B = Btn({
			BackgroundTransparency = 0, BackgroundColor3 = "ComponentColor", Text = Button.Text,
			TextColor3 = binfo.Risky and "Red" or "FontColor", LayoutOrder = #buttons + 1, Parent = Line,
		})
		Corner(B, 9)
		local st = Stroke(B, "OutlineColor", 1, 0.5)

		B.MouseEnter:Connect(function()
			if Button.Disabled then return end
			Tween(B, { BackgroundColor3 = Scheme.ComponentColor:Lerp(Scheme.AccentColor, 0.18) }, 0.15)
			st.Color = Scheme.AccentColor
		end)
		B.MouseLeave:Connect(function()
			Tween(B, { BackgroundColor3 = Scheme.ComponentColor }, 0.15)
			st.Color = Scheme.OutlineColor
		end)

		local armed = false
		B.MouseButton1Click:Connect(function()
			if Button.Disabled then return end
			Ripple(B)
			if binfo.DoubleClick and not armed then
				armed = true
				B.Text = "Are you sure?"
				B.TextColor3 = Scheme.AccentColor
				task.delay(1.5, function()
					if armed then
						armed = false
						B.Text = Button.Text
						B.TextColor3 = binfo.Risky and Scheme.Red or Scheme.FontColor
					end
				end)
				return
			end
			armed = false
			B.Text = Button.Text
			B.TextColor3 = binfo.Risky and Scheme.Red or Scheme.FontColor
			if binfo.Func then task.spawn(binfo.Func) end
		end)

		function Button:AddButton(i2, f2)
			if type(i2) == "string" then i2 = { Text = i2, Func = f2 } end
			return Make(i2)
		end
		function Button:SetText(t) self.Text = t B.Text = t end
		function Button:SetDisabled(d)
			self.Disabled = d
			B.TextTransparency = d and 0.55 or 0
		end
		function Button:SetVisible(v) B.Visible = v end

		if binfo.Disabled then Button:SetDisabled(true) end
		if binfo.Visible == false then B.Visible = false end
		AddTooltip(B, function()
			if Button.Disabled then return binfo.DisabledTooltip end
			return binfo.Tooltip
		end)

		table.insert(buttons, B)
		Layout()
		table.insert(Library.Buttons, Button)
		return Button
	end

	return Make(info)
end

function BaseGroupbox:AddLabel(a, b, c)
	local info
	if type(b) == "table" then
		info = b
		info.Idx = a
	elseif type(a) == "table" then
		info = a
	else
		info = { Text = a, DoesWrap = b, Idx = c }
	end

	local wrap = info.DoesWrap
	local Holder, Line, Addons = Row(self.Container, (not wrap) and 20 or nil)
	local L = Text({
		Text = info.Text or "", RichText = true, TextSize = info.Size or 13, TextColor3 = "SubFontColor",
		Size = wrap and UDim2.new(1, 0, 0, 0) or UDim2.new(1, -80, 1, 0),
		AutomaticSize = wrap and AUTO_Y or AUTO_NONE, TextWrapped = wrap or false, Parent = Line,
	})

	local Label = WithAddons({ Type = "Label", Text = info.Text }, Holder, Addons)
	function Label:SetText(t) self.Text = t L.Text = t end
	function Label:SetVisible(v) Holder.Visible = v end

	if info.Idx then
		Library.Labels[info.Idx] = Label
		Options[info.Idx] = Label
	end
	return Label
end

