local SCHEME_KEYS = { "BackgroundColor", "MainColor", "ComponentColor", "AccentColor", "OutlineColor", "FontColor" }
local SCHEME_NAMES = {
	BackgroundColor = "Background", MainColor = "Groupbox", ComponentColor = "Elements",
