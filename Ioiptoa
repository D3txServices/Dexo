		Library:Toggle(false)
		local key = Library.ToggleKeybind
		local name = typeof(key) == "EnumItem" and key.Name or (type(key) == "table" and key.Value) or "RightShift"
		Library:Notify({ Title = "Menu hidden", Description = "Press " .. Pretty(name) .. " to open it again.", Time = 3 })
	end)

	---------------------------------------------------------------- search
	local function Plain(s) return (tostring(s or ""):gsub("<[^>]->", "")):lower() end
	local function HolderText(h)
		local out = {}
		for _, d in ipairs(h:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then table.insert(out, d.Text) end
		end
		return Plain(table.concat(out, " "))
	end
	local function ApplySearch()
		local tab = Window.ActiveTab
		if not tab then return end
		local q = Plain(Search.Text):gsub("^%s+", ""):gsub("%s+$", "")
		for _, sec in ipairs(tab._sections) do
			local secHit = q ~= "" and Plain(sec.Name):find(q, 1, true) ~= nil
			local any = false
			for _, C in ipairs(sec.Containers) do
				for _, h in ipairs(C:GetChildren()) do
					if h:IsA("Frame") then
						local user = h:GetAttribute("UserHidden") ~= true
						local hit = q == "" or secHit or HolderText(h):find(q, 1, true) ~= nil
						h.Visible = user and hit
						if user and hit then any = true end
					end
				end
			end
			sec.Wrap.Visible = q == "" or any or secHit
		end
		Crumbs.Text = q ~= "" and ("Search  <font transparency='0.5'>›</font>  " .. Search.Text) or tab._crumb or tab.Name
	end
	Search:GetPropertyChangedSignal("Text"):Connect(ApplySearch)

	---------------------------------------------------------------- tabs
	function Window:AddTab(name, icon)
		local Tab = { Name = name, Groupboxes = {}, Tabboxes = {}, _sections = {} }

		local Item = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1, LayoutOrder = NextOrder(), Parent = Nav })
		List(Item, 2)
		local TabBtn = Btn({ Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = "MainColor", BackgroundTransparency = 1, LayoutOrder = 1, Parent = Item })
		Corner(TabBtn, 10)
		local TabStroke = New("UIStroke", { Color = "AccentColor", Thickness = 1, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = TabBtn })
		New("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.85) }), Parent = TabStroke })
		local TabBar = New("Frame", {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(3, 0),
			BackgroundColor3 = "AccentColor", BorderSizePixel = 0, ZIndex = 3, Parent = TabBtn,
		})
		Round(TabBar)
		local TabFill = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = "AccentColor", BackgroundTransparency = 1, BorderSizePixel = 0, Parent = TabBtn })
		Corner(TabFill, 10)
		New("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.82), NumberSequenceKeypoint.new(1, 1) }), Parent = TabFill })
		local Icon
		if IsAsset(icon) then
			Icon = New("ImageLabel", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0), Size = UDim2.fromOffset(15, 15),
				BackgroundTransparency = 1, Image = AssetId(icon), ImageColor3 = "SubFontColor", Parent = TabBtn,
			})
		else
			Icon = New("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, 0), Size = UDim2.fromOffset(12, 12),
				BackgroundTransparency = 1, Parent = TabBtn,
			})
			Round(Icon)
			Stroke(Icon, "SubFontColor", 1.5)
		end
		local Lbl = Text({ Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -48, 1, 0), Text = name, TextSize = 13, TextColor3 = "SubFontColor", TextTruncate = Enum.TextTruncate.AtEnd, Parent = TabBtn })

		-- tree of sections under the active tab
		local Tree = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1, Visible = false, LayoutOrder = 2, Parent = Item })
		Pad(Tree, 0, 0, 2, 6)
		local TreeLine = New("Frame", { Position = UDim2.fromOffset(21, 0), Size = UDim2.new(0, 1, 1, -12), BackgroundColor3 = "OutlineColor", BorderSizePixel = 0, Parent = Tree })
		local TreeList = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1, Parent = Tree })
		List(TreeList, 0)

		local Page = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			ScrollBarImageColor3 = "OutlineColor", CanvasSize = UDim2.new(), AutomaticCanvasSize = AUTO_Y,
			ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = Pages,
		})
		Pad(Page, 4, 10, 2, 14)
		List(Page, 14)

		local Warn = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundColor3 = "MainColor",
			Visible = false, LayoutOrder = 0, Parent = Page,
		})
		Corner(Warn, 12)
		Stroke(Warn, "Red", 1, 0.4)
		Pad(Warn, 14, 14, 10, 10)
		List(Warn, 2)
		local WarnTitle = Text({ Size = UDim2.new(1, 0, 0, 16), FontFace = FONT_BOLD, TextColor3 = "Red", RichText = true, Parent = Warn })
		local WarnText = Text({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, RichText = true, TextSize = 12, TextColor3 = "SubFontColor", LayoutOrder = 1, Parent = Warn })

		local Columns = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = Page })
		local Left = New("Frame", { Size = UDim2.new(0.5, -7, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1, Parent = Columns })
		List(Left, 16)
		local Right = New("Frame", { Position = UDim2.new(0.5, 7, 0, 0), Size = UDim2.new(0.5, -7, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1, Parent = Columns })
		List(Right, 16)

		local activeSec
		local function Crumb(sec)
			Tab._crumb = sec and (name .. "  <font transparency='0.5'>›</font>  " .. sec.Name) or name
			if Window.ActiveTab == Tab and Search.Text == "" then Crumbs.Text = Tab._crumb end
		end
		local function MarkSection(sec)
			activeSec = sec
			for _, s in ipairs(Tab._sections) do
				local on = s == sec
				Tween(s.Btn, { TextColor3 = on and Scheme.FontColor or Scheme.SubFontColor }, 0.15)
				if s.Dot then Tween(s.Dot, { Size = on and UDim2.fromOffset(5, 5) or UDim2.fromOffset(0, 0) }, 0.2, Enum.EasingStyle.Back) end
				if s.Ring then
					s.Ring.Color = on and Scheme.AccentColor or Scheme.SubFontColor
					if s.Glow then for _, l in ipairs(s.Glow) do l.mult = on and 1 or 0 end end
				end
			end
			Crumb(sec)
		end

		local function AddSection(secName, wrap)
			local sec = { Name = secName or ("Section " .. (#Tab._sections + 1)), Wrap = wrap, Containers = {} }
			local ring = wrap:FindFirstChild("Ring", true)
			if ring and ring:FindFirstChild("RingStroke") then
				sec.Ring = ring.RingStroke
				sec.Glow = Glow(ring, 6, 2, 0.7)
				for _, l in ipairs(sec.Glow) do l.mult = 0 end
			end
			local B = Btn({
				Size = UDim2.new(1, 0, 0, 26), Text = sec.Name, TextSize = 12, TextColor3 = "SubFontColor",
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = #Tab._sections + 1, Parent = TreeList,
			})
			Pad(B, 36, 6, 0, 0)
			sec.Btn = B
			sec.Dot = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, -15, 0.5, 0), Size = UDim2.fromOffset(0, 0),
				BackgroundColor3 = "AccentColor", BorderSizePixel = 0, Parent = B,
			})
			Round(sec.Dot)
			B.MouseEnter:Connect(function() if activeSec ~= sec then Tween(B, { TextColor3 = Scheme.FontColor }, 0.12) end end)
			B.MouseLeave:Connect(function() if activeSec ~= sec then Tween(B, { TextColor3 = Scheme.SubFontColor }, 0.12) end end)
			B.MouseButton1Click:Connect(function()
				if Search.Text ~= "" then Search.Text = "" end
				local scale = math.max(0.01, Scale.Scale)
				local y = Page.CanvasPosition.Y + (wrap.AbsolutePosition.Y - Page.AbsolutePosition.Y) / scale - 4
				Tween(Page, { CanvasPosition = Vector2.new(0, math.max(0, y)) }, 0.35)
				MarkSection(sec)
			end)
			Register(B, "TextColor3", function() return activeSec == sec and Scheme.FontColor or Scheme.SubFontColor end)
			table.insert(Tab._sections, sec)
			if not activeSec then MarkSection(sec) end
			return sec
		end

		-- follow the scroll: the section nearest the top of the view is "current"
		Connect(Page:GetPropertyChangedSignal("CanvasPosition"), function()
			if Window.ActiveTab ~= Tab or #Tab._sections == 0 then return end
			local top = Page.AbsolutePosition.Y + 30
			local best, bestY
			for _, s in ipairs(Tab._sections) do
				if s.Wrap.Visible then
					local y = s.Wrap.AbsolutePosition.Y
					if y <= top and (not bestY or y > bestY) then best, bestY = s, y end
				end
			end
			best = best or Tab._sections[1]
			if best ~= activeSec then MarkSection(best) end
		end)

		function Tab:Show()
			for _, other in pairs(Window.Tabs) do
				if other ~= Tab then other:_hide() end
			end
			Window.ActiveTab = Tab
			Page.Visible = true
			Tree.Visible = #Tab._sections > 0
			Page.Position = UDim2.fromOffset(0, 10)
			Tween(Page, { Position = UDim2.new() }, 0.3)
			Tween(TabBtn, { BackgroundTransparency = 0 }, 0.2)
			Tween(TabStroke, { Transparency = 0.35 }, 0.25)
			Tween(TabBar, { Size = UDim2.fromOffset(3, 18) }, 0.3, Enum.EasingStyle.Back)
			Tween(TabFill, { BackgroundTransparency = 0 }, 0.25)
			Tween(Lbl, { TextColor3 = Scheme.FontColor }, 0.2)
			if Icon:IsA("ImageLabel") then Tween(Icon, { ImageColor3 = Scheme.AccentColor }, 0.2) else Icon.UIStroke.Color = Scheme.AccentColor end
			Crumb(activeSec)
			ApplySearch()
		end
		function Tab:_hide()
			Page.Visible = false
			Tree.Visible = false
			Tween(TabBtn, { BackgroundTransparency = 1 }, 0.2)
			Tween(TabStroke, { Transparency = 1 }, 0.2)
			Tween(TabBar, { Size = UDim2.fromOffset(3, 0) }, 0.2)
			Tween(TabFill, { BackgroundTransparency = 1 }, 0.2)
			Tween(Lbl, { TextColor3 = Scheme.SubFontColor }, 0.2)
			if Icon:IsA("ImageLabel") then Tween(Icon, { ImageColor3 = Scheme.SubFontColor }, 0.2) else Icon.UIStroke.Color = Scheme.SubFontColor end
		end
		Register(Lbl, "TextColor3", function() return Window.ActiveTab == Tab and Scheme.FontColor or Scheme.SubFontColor end)
		if Icon:IsA("ImageLabel") then
			Register(Icon, "ImageColor3", function() return Window.ActiveTab == Tab and Scheme.AccentColor or Scheme.SubFontColor end)
		else
			Register(Icon.UIStroke, "Color", function() return Window.ActiveTab == Tab and Scheme.AccentColor or Scheme.SubFontColor end)
		end

		function Tab:UpdateWarningBox(w)
			w = w or {}
			Warn.Visible = w.Visible ~= false and (w.Text ~= nil or w.Title ~= nil)
			if w.Visible == false then Warn.Visible = false end
			WarnTitle.Text = w.Title or "Warning"
			WarnText.Text = w.Text or ""
		end

		function Tab:AddGroupbox(opts)
			opts = opts or {}
			local side = tostring(opts.Side or "Left"):lower()
			local gb = CreateGroupbox(side == "right" and Right or Left, opts)
			Tab.Groupboxes[opts.Name or #Tab.Groupboxes + 1] = gb
			local sec = AddSection(opts.Name, gb.Wrap)
			table.insert(sec.Containers, gb.Container)
			if Window.ActiveTab == Tab then Tree.Visible = true end
			return gb
		end
		function Tab:AddLeftGroupbox(n, ic) return self:AddGroupbox({ Side = "Left", Name = n, IconName = ic }) end
		function Tab:AddRightGroupbox(n, ic) return self:AddGroupbox({ Side = "Right", Name = n, IconName = ic }) end
		function Tab:AddTabbox(opts)
			opts = opts or {}
			local tb = CreateTabbox(tostring(opts.Side or "Left"):lower() == "right" and Right or Left, opts.Name)
			Tab.Tabboxes[opts.Name or #Tab.Tabboxes + 1] = tb
			local sec = AddSection(opts.Name or "Tabs", tb.Wrap)
			local add = tb.AddTab
			function tb:AddTab(n)
				local sub = add(self, n)
				table.insert(sec.Containers, sub.Container)
				if not opts.Name and #sec.Containers == 1 then sec.Name = n sec.Btn.Text = n end
				return sub
			end
			if Window.ActiveTab == Tab then Tree.Visible = true end
			return tb
		end
		function Tab:AddLeftTabbox(n) return self:AddTabbox({ Side = "Left", Name = n }) end
		function Tab:AddRightTabbox(n) return self:AddTabbox({ Side = "Right", Name = n }) end

		TabBtn.MouseEnter:Connect(function() if Window.ActiveTab ~= Tab then Tween(TabBtn, { BackgroundTransparency = 0.5 }, 0.15) end end)
		TabBtn.MouseLeave:Connect(function() if Window.ActiveTab ~= Tab then Tween(TabBtn, { BackgroundTransparency = 1 }, 0.15) end end)
		TabBtn.MouseButton1Click:Connect(function() Tab:Show() end)

		Window.Tabs[name] = Tab
		if not Window.ActiveTab then Tab:Show() end
		return Tab
	end

	-- mobile button: flashing initial instead of a logo
	if UIS.TouchEnabled and not UIS.KeyboardEnabled then
		local MB = Btn({
			Position = UDim2.new(0, 14, 0.5, -22), Size = UDim2.fromOffset(44, 44), BackgroundTransparency = 0.1,
			BackgroundColor3 = "BackgroundColor", Text = string.upper(string.sub(cfg.Title or "Dexo", 1, 1)),
			FontFace = FONT_BOLD, TextSize = 20, TextColor3 = "Flash", Parent = ScreenGui,
		})
		Round(MB)
		Stroke(MB, "OutlineColor", 1)
		MakeDraggable(MB, MB)
		MB.MouseButton1Click:Connect(function() Library:Toggle() end)
	end

	if Main.Visible then
		Scale.Scale = Library.DPIScale * 0.92
		Tween(Scale, { Scale = Library.DPIScale }, 0.4, Enum.EasingStyle.Back)
	end

	Library.Window = Window
	return Window
end


