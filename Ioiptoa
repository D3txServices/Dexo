		["Obsidian"] = { BackgroundColor = "0f0f0f", MainColor = "191919", ComponentColor = "262626", AccentColor = "7d55ff", OutlineColor = "282828", FontColor = "ffffff" },
		["Sakura"]   = { BackgroundColor = "120a0f", MainColor = "211419", ComponentColor = "33212a", AccentColor = "ff7ac3", OutlineColor = "3a2630", FontColor = "ffffff" },
		["Mint"]     = { BackgroundColor = "08100c", MainColor = "142019", ComponentColor = "1f3127", AccentColor = "3dd68c", OutlineColor = "24382c", FontColor = "ffffff" },
		["Ocean"]    = { BackgroundColor = "070b12", MainColor = "121a26", ComponentColor = "1c2838", AccentColor = "3ca0ff", OutlineColor = "223247", FontColor = "ffffff" },
